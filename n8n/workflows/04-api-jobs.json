    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT json_build_object(\n  'jobs', coalesce(json_agg(t ORDER BY t.posted_at DESC NULLS LAST), '[]'::json)\n) AS data\nFROM (\n  SELECT j.id, j.source, j.source_url, j.title, j.company, j.location,\n         j.work_mode, j.employment_type, j.posted_at,\n         left(j.description, 600) AS snippet,\n         m.final_score, m.rules_score, m.ai_score,\n         m.matched_skills, m.missing_skills, m.reasoning\n  FROM jobs j\n  LEFT JOIN LATERAL (\n    SELECT * FROM job_matches mm\n    WHERE mm.job_id = j.id\n    ORDER BY mm.created_at DESC\n    LIMIT 1\n  ) m ON true\n  ORDER BY j.posted_at DESC NULLS LAST\n  LIMIT 200\n) t;",
        "options": {}
      },
