      "id": "1cb71425-8e02-4467-ba03-e9d5ecb73ef8",
      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst ex = e.execution || {};\nconst wf = e.workflow || {};\nconst err = ex.error || {};\n\nfunction clean(s, n) {\n  return String(s || '')\n    .replace(/\\s+/g, ' ')\n    .replace(/[A-Fa-f0-9]{32,}/g, '[redacted]')\n    .trim()\n    .slice(0, n);\n}\n\nreturn [{\n  json: {\n    workflow_name: clean(wf.name || 'unknown', 120),\n    failed_node: clean(ex.lastNodeExecuted || '', 120),\n    error_message: clean(err.message || 'Unknown error', 500),\n    execution_id: String(ex.id || '')\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "2274e677-550f-4336-a78b-c22d90c75a57",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO error_logs (workflow_name, failed_node, error_message, execution_id)\nVALUES ($1, $2, $3, $4);",
        "options": {
          "queryReplacement": "={{ [ $json.workflow_name, $json.failed_node, $json.error_message, $json.execution_id ] }}"
        }
      },
